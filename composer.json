{
    "name": "website/noxgamingqc",
    "description": "Nox's website.",
    "keywords": ["NoxGamingQC", "Website"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1.0",
        "ext-gd": "*",
        "cebe/markdown": "^1.2",
        "globalpayments/php-sdk": "^3.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.5",
        "laravel/legacy-factories": "^1.3",
        "php-mime-mail-parser/php-mime-mail-parser": "^1.0",
        "picqer/php-barcode-generator": "^3.2",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "square/square": "^39.1",
        "symfony/http-client": "^6.1",
        "symfony/mailgun-mailer": "^6.1",
        "twbs/bootstrap": "^5.3",
        "webklex/laravel-imap": "^6.0",
        "wohali/oauth2-discord-new": "^1.0"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "fzaninotto/faker": "~1.4",
        "laravel/tinker": "3.0",
        "mockery/mockery": "~1.0",
        "nunomaduro/collision": "8.9",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "2.12",
        "symfony/thanks": "^1.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
        "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "platform-check": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "symfony/thanks": true
        },
        "audit": {
            "ignore": ["PKSA-8qx3-n5y5-vvnd", "PKSA-gytq-gtdp-3wb1", "PKSA-nhqw-xk85-x2jn"]
        }
    }
}
